# Signs admin session cookies (required on Vercel)
ADMIN_SECRET=change-me-ams-secret

# Redis / Upstash — need REST URL + TOKEN (REDIS_URL alone is not enough)
# Vercel Storage → Redis → copy these, or add as KV_* aliases:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Blob uploads (required on Vercel for image upload)
# BLOB_READ_WRITE_TOKEN=

# Optional — deliver OTP via WhatsApp/SMS (otherwise OTP is shown on screen after phone match)
# CALLMEBOT_APIKEY=
# FAST2SMS_API_KEY=
