# Signs admin session cookies (required on Vercel)
ADMIN_SECRET=change-me-ams-secret

# Vercel Redis (TCP) — auto-added when you connect Redis to the project
# REDIS_URL=redis://...

# Optional Upstash REST (alternative to REDIS_URL)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Blob uploads (required on Vercel for image upload)
# BLOB_READ_WRITE_TOKEN=

# Optional — OTP WhatsApp/SMS (otherwise OTP is shown on screen)
# CALLMEBOT_APIKEY=
# FAST2SMS_API_KEY=
